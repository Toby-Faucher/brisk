# brisk-hostd as a systemd USER service (toby, linger on). Installed by scripts/brisk-service.sh
# install into ~/.config/systemd/user/. Page + API on 127.0.0.1:8443 only; the laptop reaches it
# through `tailscale serve` at https://bawn.tail674625.ts.net:8443 (docs/ui-notes.md, Hosting).
[Unit]
Description=Brisk host agent (page, API, bridge supervisor)
Documentation=file://%h/Projects/brisk/docs/hosting-runbook.md
# Patched Sunshine (drop-in by scripts/sunshine-brisk.sh). Wants, not Requires: hostd still serves
# the page (Sunshine "down") when Sunshine is stopped or restarting.
Wants=app-dev.lizardbyte.app.Sunshine.service
After=app-dev.lizardbyte.app.Sunshine.service
# A crash loop (say 8443 held by a manual brisk-up) gives up after 10 starts in 2 min.
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
# hostd sends READY=1 once 127.0.0.1:8443 answers HTTP, STOPPING=1 on SIGTERM, and WATCHDOG=1
# every 15 s (WatchdogSec/4) while its runtime and state locks respond; a hostd that misses four
# pings in a row (60 s) is restarted.
# NotifyAccess=main: the bridge, Steam and other children inherit NOTIFY_SOCKET but are ignored.
Type=notify
NotifyAccess=main
WatchdogSec=60
TimeoutStartSec=30
ExecStart=%h/Projects/brisk/target/release/brisk-hostd %h/Projects/brisk/web/dist
Environment=BRISK_BRIDGE_BIN=%h/Projects/brisk/target/release/brisk-bridge
# `steam steam://…` runs in its own systemd-run scope, so a Steam it cold-starts (and its games)
# is outside this unit's cgroup: not under MemoryMax, not killed by a restart.
Environment=BRISK_SPAWN_SCOPE=1
# No BRISK_LISTEN: hostd asks `tailscale ip -4` at each stream start (tailscale may come up late).
# No BRISK_SECRET: hostd keeps it in ~/.config/brisk/secret (0600).
# on-failure covers a watchdog timeout and a start that never sent READY.
Restart=on-failure
RestartSec=3
# mixed: SIGTERM goes to hostd only, which stops its bridge first (the bridge cancels its
# Sunshine session; up to 12 s); whatever is left in the cgroup gets SIGKILL after TimeoutStopSec.
TimeoutStopSec=20
KillMode=mixed

# Resources: hostd + one bridge need well under 100 MB; the cap only stops a runaway.
MemoryMax=1G
CPUWeight=50
Nice=5

# Hardening, deliberately conservative. hostd runs `steam steam://…` (which can cold-start Steam
# and its games; hostd puts that in its own scope via systemd-run), swaymsg, wl-copy/wl-paste,
# signals game processes (through pidfds), systemctl --user restart Sunshine, tailscale and openssl, and sets
# PR_SET_PDEATHSIG on the bridge. Omitted, and why:
#  - NoNewPrivileges: inherited by everything hostd spawns, including a cold-started Steam (the
#    systemd-run scope keeps the process lineage), whose runtime and games may need setuid helpers.
#  - ProtectSystem / ProtectHome / PrivateTmp / PrivateUsers / ProtectProc: in a user unit these
#    need a user + mount namespace, which Steam, games and quit signals (to processes outside it) would
#    inherit or cross; hostd also writes ~/.local/share/brisk, ~/Downloads/brisk, ~/.config/brisk.
#  - RestrictAddressFamilies / IPAddressDeny: hostd and the bridge need IPv4 to tailscale and
#    Sunshine and AF_UNIX for sway, Wayland, D-Bus and tailscaled; little gained for the risk.
# Kept: the loopback-only bind (in hostd), MemoryMax, and running as toby (never root).

[Install]
WantedBy=default.target
