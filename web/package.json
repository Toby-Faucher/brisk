{
  "name": "brisk-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:all": "vitest run",
    "lint": "biome check .",
    "headless": "node scripts/headless.mjs",
    "smoke": "node scripts/ui-smoke.mjs",
    "springs:check": "node scripts/gen-spring-tokens.mjs --check",
    "check": "astro check && svelte-check --tsconfig ./tsconfig.json",
    "fmt": "biome check --write .",
    "ci": "biome check . && npm run check && npm test && npm run build",
    "test:browser": "vitest run --project browser"
  },
  "dependencies": {
    "@astrojs/svelte": "9.1.1",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "animejs": "4.5.0",
    "astro": "7.4.2",
    "bits-ui": "2.20.2",
    "layerchart": "2.8.0",
    "mediabunny": "1.61.5",
    "svelte": "5.57.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.5.15",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "26.6.5",
    "@vitest/browser": "5.0.5",
    "@vitest/browser-playwright": "5.0.5",
    "playwright": "1.64.1",
    "playwright-core": "1.64.1",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "vitest-browser-svelte": "3.1.0"
  }
}
