{
  "name": "brisk-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "test": "vitest run",
    "headless": "node scripts/headless.mjs",
    "smoke": "node scripts/ui-smoke.mjs",
    "springs:check": "node scripts/gen-spring-tokens.mjs --check",
    "check": "astro check && svelte-check --tsconfig ./tsconfig.json",
    "ci": "npm run check && npm test && npm run build"
  },
  "dependencies": {
    "@astrojs/svelte": "9.1.1",
    "@fontsource/geist": "5.3.0",
    "@fontsource/geist-mono": "5.3.0",
    "animejs": "4.5.0",
    "astro": "7.4.2",
    "bits-ui": "2.20.2",
    "layerchart": "2.7.0",
    "mediabunny": "1.61.4",
    "svelte": "5.57.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/node": "26.6.5",
    "playwright-core": "1.64.1",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
